-- Load saved timings or use defaults
local animTimings = {}
local function loadTimings()
	pcall(function()
		if isfile(SAVE_FILE) then
			local data = game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
			for id, t in pairs(data) do
				animTimings[id] = t
			end
			print("Loaded saved timings!")
		end
	end)
	-- Fill in any missing with defaults
	for id, t in pairs(defaultTimings) do
		if not animTimings[id] then
			animTimings[id] = t
		end
	end
end

local function saveTimings()
	pcall(function()
		writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode(animTimings))
	end)
end

loadTimings()

local lastTriggeredAnim = nil
local lastTriggeredTime = nil
local lastPressTime = nil
local weaveSucceeded = false
local lastAnimTrack = nil -- track the actual playing track so we can check TimePosition
local connections = {}
local walkspeedConnections = {}

local function notify(text, color)
	local screenGui = Instance.new("ScreenGui")
	screenGui.ResetOnSpawn = false
	screenGui.Parent = player.PlayerGui
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 200, 0, 50)
	frame.Position = UDim2.new(1, -210, 0.5, 0)
	frame.BackgroundColor3 = color or Color3.fromRGB(30, 30, 30)
	frame.BorderSizePixel = 0
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	task.delay(2, function() screenGui:Destroy() end)
end

local function getDistance(otherChar)
	local myChar = player.Character
	if not myChar then return math.huge end
	local r1 = myChar:FindFirstChild("HumanoidRootPart")
	local r2 = otherChar:FindFirstChild("HumanoidRootPart")
	if not r1 or not r2 then return math.huge end
	return (r1.Position - r2.Position).Magnitude
end

local function pressR()
	local now = tick()
	if now - lastPress < DEBOUNCE_TIME then return end
	lastPress = now
	weaveSucceeded = false
	lastPressTime = now

	-- Snapshot the track's TimePosition at press time to determine if we were early or late
	local trackAtPress = lastAnimTrack
	local timePosAtPress = (trackAtPress and trackAtPress.IsPlaying) and trackAtPress.TimePosition or nil
	local animAtPress = lastTriggeredAnim

	VIM:SendKeyEvent(true, Enum.KeyCode.R, false, game)
	task.wait(0.05)
	VIM:SendKeyEvent(false, Enum.KeyCode.R, false, game)

	task.delay(0.5, function()
		if not animAtPress or not animTimings[animAtPress] then return end
		if not weaveSucceeded then
			-- Missed — figure out if we were too early or too late
			if timePosAtPress and animTimings[animAtPress] then
				local diff = timePosAtPress - animTimings[animAtPress]
				if diff < -0.03 then
					-- We pressed way before the timing — nudge later
					animTimings[animAtPress] = math.min(0.6, animTimings[animAtPress] + 0.01)
					print("Too early, nudged " .. animAtPress .. " later to " .. string.format("%.3f", animTimings[animAtPress]))
				else
					-- We pressed at or after timing but still missed — nudge earlier
					animTimings[animAtPress] = math.max(0.05, animTimings[animAtPress] - 0.01)
					print("Too late, nudged " .. animAtPress .. " earlier to " .. string.format("%.3f", animTimings[animAtPress]))
				end
			else
				-- No track info, nudge earlier as fallback
				animTimings[animAtPress] = math.max(0.05, animTimings[animAtPress] - 0.01)
			end
			saveTimings()
		end
	end)
end

local function watchMyAnimator()
	local char = player.Character or player.CharacterAdded:Wait()
	local humanoid = char:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")
	animator.AnimationPlayed:Connect(function(track)
		local id = track.Animation.AnimationId:match("%d+")
		if successAnims[id] then
			weaveSucceeded = true
			if lastTriggeredAnim and animTimings[lastTriggeredAnim] then
				-- Succeeded — nudge slightly later to find sweet spot
				animTimings[lastTriggeredAnim] = math.min(0.6, animTimings[lastTriggeredAnim] + 0.005)
				print("Weave succeeded! nudged " .. lastTriggeredAnim .. " later to " .. string.format("%.3f", animTimings[lastTriggeredAnim]))
				saveTimings()
			end
			lastTriggeredAnim = nil
			lastTriggeredTime = nil
			lastAnimTrack = nil
		end
	end)
end

local function watchWalkspeed(p)
	local char = p.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local c = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if not running then return end
		local ws = humanoid.WalkSpeed
		if ws > 0 and ws < 10 and getDistance(char) <= RADIUS then
			pressR()
		end
	end)
	table.insert(walkspeedConnections, c)
end

local function watchPlayer(p)
	if p == player then return end
	local function connectAnimator(char)
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
		if not animator then return end
		local c = animator.AnimationPlayed:Connect(function(track)
			if not running then return end
			if getDistance(char) > RADIUS then return end
			local id = track.Animation.AnimationId:match("%d+")
			if ignoreAnims[id] then return end
			local delay = animTimings[id]
			if delay then
				lastTriggeredAnim = id
				lastTriggeredTime = tick()
				lastAnimTrack = track
				task.delay(delay, function()
					if running and getDistance(char) <= RADIUS then pressR() end
				end)
			end
		end)
		table.insert(connections, c)
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			local id = track.Animation.AnimationId:match("%d+")
			if not ignoreAnims[id] then
				local delay = animTimings[id]
				if delay and getDistance(char) <= RADIUS then
					lastTriggeredAnim = id
					lastTriggeredTime = tick()
					lastAnimTrack = track
					task.delay(delay, function()
						if running and getDistance(char) <= RADIUS then pressR() end
					end)
				end
			end
		end
		watchWalkspeed(p)
	end
	if p.Character then connectAnimator(p.Character) end
	local c = p.CharacterAdded:Connect(function(char)
		if running then connectAnimator(char) end
	end)
	table.insert(connections, c)
end

local function watch()
	for _, p in ipairs(Players:GetPlayers()) do
		watchPlayer(p)
	end
	watchMyAnimator()
end

local function stop()
	for _, c in ipairs(connections) do c:Disconnect() end
	for _, c in ipairs(walkspeedConnections) do c:Disconnect() end
	connections = {}
	walkspeedConnections = {}
end

UIS.InputBegan:Connect(function(input, gp)
	if input.KeyCode == Enum.KeyCode.P and not gp then
		running = not running
		if running then
			watch()
			notify("Auto Weave: ON", Color3.fromRGB(0, 180, 0))
		else
			stop()
			notify("Auto Weave: OFF", Color3.fromRGB(180, 0, 0))
		end
	end
end)

Players.PlayerAdded:Connect(function(p)
	if running then watchPlayer(p) end
end)
